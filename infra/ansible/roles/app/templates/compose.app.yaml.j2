x-logging: &logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  frontend:
    image: {{ registry_url }}/frontend:{{ app_version }}
    ports:
      - "80:8080"
    depends_on:
      api:
        condition: service_healthy
    restart: unless-stopped
    init: true
    read_only: true
    tmpfs:
      - /tmp:size=32m,mode=1777
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    healthcheck:
      test: [CMD, wget, -q, -O, /dev/null, "http://127.0.0.1:8080/healthz"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 10s
    networks: [web]
    logging: *logging

  api:
    image: {{ registry_url }}/api:{{ app_version }}
    environment:
      NODE_ENV: production
      HOST: 0.0.0.0
      PORT: "3000"
      APP_VERSION: "{{ app_version }}"
      MONGO_HOST: "{{ db_private_ip }}"
      MONGO_PORT: "{{ mongo_port }}"
      MONGO_DATABASE: {{ mongo_database }}
      MONGO_AUTH_SOURCE: {{ mongo_database }}
      MONGO_USERNAME: {{ mongo_app_username }}
      MONGO_PASSWORD_FILE: /run/secrets/mongo_app_password
    secrets:
      - mongo_app_password
    restart: unless-stopped
    init: true
    read_only: true
    tmpfs:
      - /tmp:size=16m,mode=1777
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    stop_grace_period: 20s
    healthcheck:
      test: [CMD, node, -e, "fetch('http://127.0.0.1:3000/api/health/ready',{signal:AbortSignal.timeout(2500)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 10s
      timeout: 4s
      retries: 3
      start_period: 30s
    networks: [web]
    logging: *logging

networks:
  web:

secrets:
  mongo_app_password:
    file: ./mongo-app-password
