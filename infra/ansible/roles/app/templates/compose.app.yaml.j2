services:

  frontend:
    image: {{ registry_url }}/frontend:{{ app_version }}

    restart: unless-stopped

    ports:
      - "80:8080"

    depends_on:
      api:
        condition: service_healthy

    networks:
      - web

  api:
    image: {{ registry_url }}/api:{{ app_version }}

    restart: unless-stopped

    environment:
      NODE_ENV: production
      HOST: 0.0.0.0
      PORT: "3000"

      APP_VERSION: "{{ app_version }}"

      MONGO_HOST: "{{ db_private_ip }}"
      MONGO_PORT: "27017"

      MONGO_DATABASE: kubeshop
      MONGO_AUTH_SOURCE: kubeshop
      MONGO_USERNAME: kubeshop

      MONGO_PASSWORD_FILE: /run/secrets/mongo_app_password

    secrets:
      - mongo_app_password

    networks:
      - web

    healthcheck:
      test:
        [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/api/health/ready',{signal:AbortSignal.timeout(2500)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ]

      interval: 10s
      timeout: 4s
      retries: 3
      start_period: 30s

secrets:

  mongo_app_password:
    file: ./mongo-app-password

networks:

  web: